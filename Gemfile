source "https://rubygems.org"

# Jekyll 3 matches the GitHub Pages rendering pipeline.
gem "jekyll", "~> 3.9.5"
gem "jekyll-sitemap", "~> 1.4"
gem "kramdown-parser-gfm", "~> 1.1"

# Jekyll 3's preview server requires WEBrick, which Ruby 3 no longer bundles.
gem "webrick", "~> 1.8"

# Allow local builds on the macOS system Ruby as well as modern Ruby.
gem "ffi", "1.17.0"
