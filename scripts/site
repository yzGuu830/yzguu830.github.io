#!/bin/sh
# Keep native gems and preview output local to each machine, outside Google Drive.
set -eu
site_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$site_root"
# On macOS, prefer a separately installed Ruby over Apple's system Ruby.
if [ "$(uname -s)" = Darwin ]; then
  if ruby -e 'exit(RUBY_VERSION.split(".").first.to_i < 3 ? 0 : 1)'; then
    for site_ruby_bin in /opt/homebrew/opt/ruby@3.3/bin /usr/local/opt/ruby@3.3/bin; do
      if [ -x "$site_ruby_bin/ruby" ]; then
        export PATH="$site_ruby_bin:$PATH"
        break
      fi
    done
  fi
  if ! ruby -rrbconfig -e 'exit(File.file?(File.join(RbConfig::CONFIG.fetch("rubyarchhdrdir"), "ruby/config.h")) ? 0 : 1)'; then
    cat >&2 <<'HELP'
Ruby development headers are missing on THIS Mac.
Install a separate Ruby with Homebrew, then rerun this command:

  brew install ruby@3.3
  sh scripts/site serve

Install Homebrew first if needed: https://brew.sh
HELP
    exit 1
  fi
fi
case "$(uname -s)" in
  Darwin) site_cache_base="${XDG_CACHE_HOME:-$HOME/Library/Caches}" ;;
  *) site_cache_base="${XDG_CACHE_HOME:-$HOME/.cache}" ;;
esac
site_ruby_id=$(ruby -e 'print "#{RUBY_ENGINE}-#{RUBY_VERSION}-#{RUBY_PLATFORM}"')
site_runtime_root="$site_cache_base/yzguu830-site/$site_ruby_id"
export BUNDLE_APP_CONFIG="$site_runtime_root/bundle-config"
export GEM_HOME="$site_runtime_root/gems"
export GEM_PATH="$GEM_HOME"
export PATH="$GEM_HOME/bin:$PATH"

bundle_version=$(awk '/^BUNDLED WITH$/ { getline; gsub(/[[:space:]]/, ""); print; exit }' Gemfile.lock)
if [ -z "$bundle_version" ]; then
  echo 'Missing Bundler version in Gemfile.lock' >&2
  exit 1
fi
command_name=${1:-serve}
if [ "$#" -gt 0 ]; then shift; fi
case "$command_name" in
  setup|serve|build) ;;
  *) echo 'Usage: ./scripts/site [setup|serve|build] [Jekyll options]' >&2; exit 2 ;;
esac

if ! gem list --local --exact bundler --version "$bundle_version" --installed >/dev/null; then
  gem install bundler --version "$bundle_version" --no-document
fi
if ! bundle "_${bundle_version}_" check >/dev/null 2>&1; then
  if [ "$(uname -s)" = Darwin ]; then
    # Some Command Line Tools installations omit the SDK's libc++ headers
    # from the compiler search path. EventMachine needs these to compile.
    if ! printf '#include <iostream>\n' | c++ -x c++ -fsyntax-only - >/dev/null 2>&1; then
      site_sdk_path=$(xcrun --sdk macosx --show-sdk-path)
      if [ -f "$site_sdk_path/usr/include/c++/v1/iostream" ]; then
        export CPLUS_INCLUDE_PATH="$site_sdk_path/usr/include/c++/v1${CPLUS_INCLUDE_PATH:+:$CPLUS_INCLUDE_PATH}"
      fi
      if ! printf '#include <iostream>\n' | c++ -x c++ -fsyntax-only - >/dev/null 2>&1; then
        echo 'C++ standard library headers are unavailable. Repair or reinstall the Xcode Command Line Tools, then rerun this command.' >&2
        exit 1
      fi
      echo "Using C++ headers from $site_sdk_path."
    fi
  fi
  bundle "_${bundle_version}_" install
fi
case "$command_name" in
  setup) echo "Local dependencies are ready in $GEM_HOME." ;;
  serve) JEKYLL_ENV=development exec bundle "_${bundle_version}_" exec jekyll serve --host 127.0.0.1 --destination "$site_runtime_root/preview" --force_polling "$@" ;;
  build) JEKYLL_ENV=production exec bundle "_${bundle_version}_" exec jekyll build --strict_front_matter "$@" ;;
esac
